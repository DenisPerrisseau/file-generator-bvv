<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Création de la table target_urls -->
    <changeSet id="007-create-target-urls-table" author="system">
        <createTable tableName="target_urls">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="bearer_token" type="VARCHAR(1000)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Ajout des colonnes dans generation_jobs -->
    <changeSet id="007-add-columns-to-jobs" author="system">
        <addColumn tableName="generation_jobs">
            <column name="target_url_id" type="BIGINT"/>
            <column name="expected_lines_treated" type="INTEGER"/>
            <column name="expected_lines_insert" type="INTEGER"/>
            <column name="expected_lines_update" type="INTEGER"/>
            <column name="expected_lines_ignored" type="INTEGER"/>
            <column name="expected_http_status" type="INTEGER"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="generation_jobs"
                baseColumnNames="target_url_id"
                constraintName="fk_job_target_url"
                referencedTableName="target_urls"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

    <!-- Ajout des colonnes dans generation_logs pour la réponse serveur -->
    <changeSet id="007-add-response-columns-to-logs" author="system">
        <addColumn tableName="generation_logs">
            <column name="actual_lines_treated" type="INTEGER"/>
            <column name="actual_lines_insert" type="INTEGER"/>
            <column name="actual_lines_update" type="INTEGER"/>
            <column name="actual_lines_ignored" type="INTEGER"/>
            <column name="response_status" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

    <!-- Insertion de quelques URLs de test -->
    <changeSet id="007-insert-sample-target-urls" author="system">
        <insert tableName="target_urls">
            <column name="name" value="API Développement"/>
            <column name="url" value="http://localhost:8081/api/files/import"/>
            <column name="bearer_token" value="dev_token_12345"/>
            <column name="description" value="API de test en développement"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueDate="now()"/>
            <column name="updated_at" valueDate="now()"/>
        </insert>

        <insert tableName="target_urls">
            <column name="name" value="API Production"/>
            <column name="url" value="https://api.production.com/api/files/import"/>
            <column name="bearer_token" value="prod_token_xyz789"/>
            <column name="description" value="API de production"/>
            <column name="active" valueBoolean="false"/>
            <column name="created_at" valueDate="now()"/>
            <column name="updated_at" valueDate="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>

